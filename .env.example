# HushNode environment template.
# Copy this file to .env and edit as needed. dotenv loads .env from the project
# root at startup. .env is gitignored: never commit real credentials or secrets.
# Configuration details and constraints: docs/operations.md.

# ------------------------------- Server ------------------------------------

# HTTP bind address. The default binds loopback only. Public deployments must
# sit behind a trusted TLS reverse proxy.
HOST=127.0.0.1

# Default 8788 to avoid clashing with the Hush wallet service on 8787.
PORT=8788

# Binding to a non-loopback address is refused unless this is true. Enable it
# only behind a trusted TLS reverse proxy.
# ALLOW_PLAINTEXT_REMOTE=false

# --------------------------- Data and syncing ------------------------------

# Root directory for the RAILGUN LevelDB and proving-artifact cache. Never
# point multiple processes at the same data directory.
# HUSH_NODE_DATA_DIR=./data

# Delay between incremental scans after a chain completes a sync pass, in
# seconds. Range: 15-2147483.
# HUSH_NODE_CHAIN_SYNC_INTERVAL_SECONDS=60

# ----------------------------- Network access ------------------------------

# Optional HTTP(S) proxy for RPC, RAILGUN PPOI, QuickSync, and other outbound
# requests. HTTPS_PROXY, HTTP_PROXY, and ALL_PROXY are also honored.
# HUSH_NODE_NETWORK_PROXY=http://127.0.0.1:7890

# Optional RPC overrides. Separate multiple URLs with commas or whitespace.
# Setting these replaces the built-in node list for that network entirely.
# HUSH_NODE_ETHEREUM_RPC=https://your-eth-rpc.example
# HUSH_NODE_ARBITRUM_RPC=https://your-arbitrum-rpc.example

# -------------------------------- Light API --------------------------------

# Enabled by default on dedicated nodes. When false, every /api/light/v1 route
# returns 404.
LIGHT_API_ENABLED=true

# Exact browser origins allowed for CORS, separated by commas or whitespace.
# Wildcards are not supported.
# LIGHT_CORS_ORIGINS=http://localhost:8081,http://localhost:4173

# Shared per-IP requests per minute for the six read-only /evm/* endpoints.
# Range: 10-1200.
# LIGHT_EVM_RATE_PER_MINUTE=120

# Shared per-IP requests per minute for /status, /trees/*, /fees, and /prices.
# Range: 10-6000.
# LIGHT_READ_RATE_PER_MINUTE=300

# Per-IP requests per minute for /anchor. Range: 10-1200.
# LIGHT_ANCHOR_RATE_PER_MINUTE=60

# Number of trusted reverse-proxy hops in front of HushNode, 0-16.
# Keep 0 unless a trusted proxy sets X-Forwarded-For; a wrong value lets
# clients spoof their rate-limit identity.
# LIGHT_TRUST_PROXY_HOPS=0

# Optional extra read-only call targets beyond the built-in token and RAILGUN
# contract allowlist. Accepts only 0x-prefixed 20-byte addresses, separated by
# commas or whitespace. This is not a general RPC proxy: added addresses are
# allowed for both /evm/call and /evm/estimate-gas.
# LIGHT_EVM_EXTRA_TARGETS_ETHEREUM=0x1111111111111111111111111111111111111111
# LIGHT_EVM_EXTRA_TARGETS_ARBITRUM=0x2222222222222222222222222222222222222222

# ---------------------------- Remote note scan -----------------------------

# Optional server-side note scanning with a shareable viewing key.
# Scanning is enabled automatically when LIGHT_SCAN_TOKEN is at least 24
# characters; set LIGHT_SCAN_ENABLED=false to force it off. The node can then
# see all private transfers and balances for that account, but never receives
# the spending key. Use only on a node you run or explicitly trust.
LIGHT_SCAN_TOKEN=<at least 24 random characters; never reuse another secret>
LIGHT_SCAN_ENABLED=true
# LIGHT_SCAN_MAX_JOBS=1
# LIGHT_SCAN_TTL_SECONDS=120
# LIGHT_SCAN_TIMEOUT_SECONDS=900
# LIGHT_SCAN_RATE_PER_MINUTE=6
# LIGHT_SCAN_MAX_NOTES=5000

# Decryption batch size read by the engine patch. Smaller batches yield to the
# event loop more often and keep public endpoints responsive; larger batches are
# slightly faster but block longer. Range: 100-4000.
# HUSH_SCAN_BATCH_SIZE=200

# On-disk resume cache for scan progress, bucketed by viewing-key digest and
# including the wallet DB (notes and treeScannedHeights) so restarts can resume.
# Default TTL is 7 days; set 0 to keep everything in memory only. The cache
# contains decrypted private notes, so use a private data directory and
# full-disk encryption.
# LIGHT_SCAN_CACHE_DIR=./data/scan
# LIGHT_SCAN_CACHE_TTL_SECONDS=604800
# LIGHT_SCAN_CACHE_MAX_BUCKETS=64
# LIGHT_SCAN_CACHE_MAX_BYTES=536870912

# -------------------------- Signed transaction relay -----------------------

# Optional relay for already-signed raw transactions. Disabled by default.
LIGHT_RELAY_ENABLED=true
# LIGHT_RELAY_MAX_BYTES=131072
# LIGHT_RELAY_RATE_PER_MINUTE=12

# ----------------------------- Broadcaster relay ---------------------------

# Optional broadcaster relay (/broadcaster/quote and /broadcaster/transact via
# Waku). Disabled by default; the node never holds a hot wallet. It requires
# the Light API to be enabled.
LIGHT_BROADCASTER_ENABLED=true
# LIGHT_BROADCASTER_RATE_PER_MINUTE=30
# LIGHT_BROADCASTER_TRANSACT_RATE_PER_MINUTE=10

# --------------------------------- Logging ---------------------------------

# One of debug, info, warn, error. Defaults to info when unset.
# LOG_LEVEL=info
