{
  "name": "hush-node",
  "version": "0.1.0",
  "private": true,
  "description": "Public read-only RAILGUN light index API",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node --no-warnings dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run test:typecheck && pnpm test && pnpm run docs:check",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@railgun-community/engine": "9.9.1",
    "@railgun-community/shared-models": "8.2.3",
    "@railgun-community/waku-broadcaster-client-node": "10.0.1",
    "@railgun-community/wallet": "11.2.0",
    "dotenv": "^16.4.7",
    "ethers": "6.14.3",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "leveldown": "6.1.1",
    "memdown": "6.1.1",
    "snarkjs": "0.7.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/memdown": "3.0.5",
    "@types/node": "^24.10.1",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
